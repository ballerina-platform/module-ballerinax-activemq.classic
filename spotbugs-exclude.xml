<FindBugsFilter>
    <!-- Cleanup failures must not replace the original initialization error. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.util.CommonUtils"/>
        <Method name="closeQuietly"/>
        <Bug pattern="DE_MIGHT_IGNORE"/>
    </Match>

    <!-- JMS resources cannot be cloned. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.listener.MessageReceiver"/>
        <Field name="session"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.ballerina.lib.activemq.listener.MessageReceiver"/>
        <Field name="consumer"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.ballerina.lib.activemq.listener.MessageReceiver"/>
        <Field name="messageDispatcher"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- ConnectionConfig intentionally exposes its record values. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.util.ConnectionConfig"/>
        <Method name="properties"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="io.ballerina.lib.activemq.util.ConnectionConfig"/>
        <Method name="secureSocket"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="io.ballerina.lib.activemq.util.ConnectionConfig"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- The Ballerina runtime requires the service's internal BObject. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.listener.Service"/>
        <Method name="getConsumerService"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
