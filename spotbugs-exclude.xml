<FindBugsFilter>
    <!-- Cleanup failures must not replace the original initialization error. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.util.CommonUtils"/>
        <Method name="closeQuietly"/>
        <Bug pattern="DE_MIGHT_IGNORE"/>
    </Match>

    <!-- JMS resources cannot be cloned. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.listener.MessageReceiver"/>
        <Field name="session"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.ballerina.lib.activemq.listener.MessageReceiver"/>
        <Field name="consumer"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.ballerina.lib.activemq.listener.MessageReceiver"/>
        <Field name="messageDispatcher"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- ConnectionConfig intentionally exposes its record values. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.util.ConnectionConfig"/>
        <Method name="properties"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="io.ballerina.lib.activemq.util.ConnectionConfig"/>
        <Method name="secureSocket"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="io.ballerina.lib.activemq.util.ConnectionConfig"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- The Ballerina runtime requires the service's internal BObject. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.listener.Service"/>
        <Method name="getConsumerService"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- stop() intentionally declares a broad throws Exception to consolidate the JMSException
         thrown by MessageConsumer#close()/Session#close(); it's a plain method, not a framework
         override, so the throws clause can't be narrowed to a single checked exception type. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.listener.MessageReceiver"/>
        <Method name="stop"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>

    <!-- These SSL/TLS helpers intentionally declare a broad throws Exception to consolidate
         several distinct checked exceptions from the KeyStore/TrustManagerFactory/
         KeyManagerFactory APIs (KeyStoreException, NoSuchAlgorithmException,
         CertificateException, IOException) plus a custom decode-failure Exception; none are
         framework-interface overrides. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.util.SslUtils"/>
        <Method name="getTrustManagerFactory"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
    <Match>
        <Class name="io.ballerina.lib.activemq.util.SslUtils"/>
        <Method name="getKeyManagerFactory"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
    <Match>
        <Class name="io.ballerina.lib.activemq.util.SslUtils"/>
        <Method name="getKeyStore"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>

    <!-- ThrowingRunnable is the cleanup action closeQuietly runs, such as a JMS close() that throws
         JMSException; it declares throws Exception so any close action fits, and closeQuietly swallows it. -->
    <Match>
        <Class name="io.ballerina.lib.activemq.util.CommonUtils$ThrowingRunnable"/>
        <Method name="run"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
</FindBugsFilter>
